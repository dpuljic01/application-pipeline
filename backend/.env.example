APP_ENV=dev
DATABASE_URL=postgresql+psycopg://app_pipeline_user:app_pipeline_password@localhost:5432/app_pipeline_db

# AWS Cognito Configuration
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# LLM Configuration
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_MODEL=
# Global daily LLM spend cap across all users (USD), checked before every call
LLM_DAILY_BUDGET_USD=1.0
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Job Search Configuration
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ch

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Shared demo account (a normal Cognito user); leave unset to disable /auth/demo
DEMO_EMAIL=
DEMO_PASSWORD=
# The demo account's own daily LLM cap (USD), on top of the global one
LLM_DEMO_DAILY_BUDGET_USD=0.25
