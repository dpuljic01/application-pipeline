.mypy_cache/

# =====================
# Virtual environments
# =====================
.venv/
venv/
ENV/
env/

# =====================
# Poetry
# =====================
# Keep poetry.lock COMMITTED
# Do NOT ignore poetry.lock
.poetry/
.ruff_cache/

